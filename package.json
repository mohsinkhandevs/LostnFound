{
  "name": "lost-and-found-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "cd server && npm install",
    "install:all": "npm install && cd server && npm install",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "cd server && node server.js",
    "server:dev": "cd server && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"cd server && npm run dev\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.20.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^7.0.10"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^7.2.4",
    "concurrently": "^8.2.2"
  }
}